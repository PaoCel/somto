{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=60" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
        ]
      },
      {
        "source": "/service-worker.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Service-Worker-Allowed", "value": "/" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/share/title/**",
        "function": "shareTitlePreview"
      },
      {
        "source": "/quiz/invite/**",
        "function": "quizInvitePreview"
      },
      {
        "source": "/quiz/**",
        "function": "quizPage"
      },
      {
        "source": "/sitemap-quiz.xml",
        "function": "sitemapQuiz"
      },
      {
        "source": "/lista/**",
        "function": "listPage"
      },
      {
        "source": "/sitemap-lista.xml",
        "function": "sitemapLists"
      },
      {
        "source": "/novita/**",
        "function": "officialUpdatePage"
      },
      {
        "source": "/prossime-uscite.json",
        "function": "upcomingReleasesFeed"
      },
      {
        "source": "/film/**",
        "function": "titlePage"
      },
      {
        "source": "/serie/**",
        "function": "titlePage"
      },
      {
        "source": "/sitemap-titoli.xml",
        "function": "sitemapTitles"
      },
      {
        "source": "/sitemap-titoli-index.xml",
        "function": "sitemapTitles"
      },
      {
        "source": "/sitemap-titoli-*.xml",
        "function": "sitemapTitles"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    },
    {
      "source": "functions-public-profile",
      "codebase": "publicprofile",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
