<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

  <title>{{ metaTitle or title ~ " — Somto" }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.blogBaseUrl }}/{{ slug }}/">
  <link rel="alternate" hreflang="it-IT" href="{{ site.blogBaseUrl }}/{{ slug }}/">
  <link rel="alternate" hreflang="x-default" href="{{ site.blogBaseUrl }}/{{ slug }}/">
  <meta name="robots" content="index,follow">
  <meta name="theme-color" content="#0A0A0A">
  <meta name="author" content="Somto">

  <!-- Open Graph -->
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="Somto">
  <meta property="og:locale" content="it_IT">
  <meta property="og:url" content="{{ site.blogBaseUrl }}/{{ slug }}/">
  <meta property="og:title" content="{{ title }} — Somto">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="{{ site.baseUrl }}/og/blog/{{ slug }}.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:alt" content="{{ title }} — Somto">
  <meta property="article:published_time" content="{{ date | isoDate }}">
  <meta property="article:author" content="Somto">
  {%- if category %}
  <meta property="article:section" content="{{ category }}">
  {%- endif %}
  {%- if postTags %}
  {%- for tag in postTags %}
  <meta property="article:tag" content="{{ tag }}">
  {%- endfor %}
  <meta name="keywords" content="{{ postTags | join(', ') }}">
  {%- endif %}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} — Somto">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ site.baseUrl }}/og/blog/{{ slug }}.png">

  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-180.png">

  <link rel="stylesheet" href="/css/landing.bundle.css">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ title | dump | safe }},
    "description": {{ description | dump | safe }},
    "datePublished": "{{ date | isoDate }}",
    "dateModified": "{{ date | isoDate }}",
    "inLanguage": "it-IT",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "{{ site.blogBaseUrl }}/{{ slug }}/"
    },
    "image": "{{ site.baseUrl }}/og/blog/{{ slug }}.png",
    "author": {
      "@type": "Organization",
      "name": "Somto",
      "url": "{{ site.baseUrl }}/"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Somto",
      "url": "{{ site.baseUrl }}/",
      "logo": {
        "@type": "ImageObject",
        "url": "{{ site.baseUrl }}/icons/icon-512.png"
      }
    }
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.baseUrl }}/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "{{ site.blogBaseUrl }}/" },
      { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "{{ site.blogBaseUrl }}/{{ slug }}/" }
    ]
  }
  </script>

  <style>
    /* ===== Blog — stili specifici, additivi al design system Somto ===== */
    .blog-article {
      padding-top: calc(var(--safe-top) + 6.5rem);
      padding-bottom: 1rem;
    }
    .blog-wrap {
      width: 100%;
      max-width: 720px;
      margin: 0 auto;
      padding: 0 1.25rem;
    }
    .blog-crumbs {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 1.2rem;
    }
    .blog-crumbs a { color: var(--text-secondary); }
    .blog-crumbs a:hover { color: var(--text-primary); }
    .blog-crumbs span[aria-hidden] { margin: 0 0.4rem; }

    .blog-article h1 {
      font-family: var(--font-display);
      font-size: clamp(1.9rem, 5.2vw, 3rem);
      font-weight: var(--weight-black);
      letter-spacing: -0.03em;
      line-height: 1.1;
      margin: 0.4rem 0 0.8rem;
    }
    .blog-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem 1rem;
      align-items: center;
      color: var(--text-muted);
      font-size: 0.88rem;
      margin-bottom: 2rem;
      padding-bottom: 1.6rem;
      border-bottom: 1px solid var(--border);
    }
    .blog-lede {
      font-size: clamp(1.05rem, 2.4vw, 1.22rem);
      line-height: 1.6;
      color: var(--text-secondary);
      margin: 0 0 1.8rem;
    }

    .blog-body {
      font-size: 1.04rem;
      line-height: 1.75;
      color: var(--text-secondary);
    }
    .blog-body > *:first-child { margin-top: 0; }
    .blog-body p { margin: 0 0 1.15rem; }
    .blog-body h2 {
      font-family: var(--font-display);
      font-size: clamp(1.4rem, 3.6vw, 1.9rem);
      font-weight: var(--weight-black);
      letter-spacing: -0.02em;
      line-height: 1.2;
      color: var(--text-primary);
      margin: 2.6rem 0 0.9rem;
    }
    .blog-body h3 {
      font-family: var(--font-display);
      font-size: 1.18rem;
      font-weight: var(--weight-bold);
      color: var(--text-primary);
      margin: 1.9rem 0 0.6rem;
    }
    .blog-body a {
      color: #FF6FA5;
      text-decoration: underline;
      text-underline-offset: 2px;
      text-decoration-thickness: 1px;
    }
    .blog-body a:hover { color: var(--brand-primary); }
    .blog-body strong { color: var(--text-primary); font-weight: var(--weight-bold); }
    .blog-body ul, .blog-body ol {
      margin: 0 0 1.3rem;
      padding-left: 1.4rem;
    }
    .blog-body li { margin-bottom: 0.55rem; }
    .blog-body li::marker { color: #FF6FA5; }
    .blog-body blockquote {
      margin: 1.6rem 0;
      padding: 0.9rem 1.25rem;
      border-left: 3px solid var(--brand-primary);
      background: var(--panel);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
      color: var(--text-secondary);
      font-style: italic;
    }
    .blog-body blockquote p:last-child { margin-bottom: 0; }
    .blog-body hr {
      border: 0;
      border-top: 1px solid var(--border);
      margin: 2.4rem 0;
    }
    .blog-body table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.6rem 0;
      font-size: 0.96rem;
    }
    .blog-body th, .blog-body td {
      text-align: left;
      padding: 0.7rem 0.85rem;
      border-bottom: 1px solid var(--border);
    }
    .blog-body th {
      color: var(--text-primary);
      font-weight: var(--weight-bold);
    }

    /* CTA in-articolo verso l'app */
    .blog-cta {
      margin: 2.6rem 0;
      padding: 1.7rem 1.5rem;
      border-radius: var(--radius-card);
      text-align: center;
      background: linear-gradient(140deg, rgba(247, 119, 55, 0.16), rgba(233, 30, 99, 0.18), rgba(156, 39, 176, 0.20));
      border: 1px solid var(--border-medium);
    }
    .blog-cta h2 {
      font-family: var(--font-display);
      font-size: 1.3rem;
      font-weight: var(--weight-black);
      color: var(--text-primary);
      margin: 0 0 0.5rem;
    }
    .blog-cta p {
      color: var(--text-secondary);
      margin: 0 auto 1.2rem;
      max-width: 440px;
      font-size: 0.98rem;
    }

    /* Articoli correlati */
    .blog-related {
      margin: 3rem 0 0;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
    }
    .blog-related h2 {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: var(--weight-bold);
      color: var(--text-primary);
      margin: 0 0 1rem;
    }
    .blog-related-grid {
      display: grid;
      gap: 0.9rem;
      grid-template-columns: 1fr;
    }
    @media (min-width: 620px) {
      .blog-related-grid { grid-template-columns: 1fr 1fr; }
    }
    .blog-related-card {
      display: block;
      padding: 1.1rem 1.2rem;
      border-radius: var(--radius-lg);
      background: var(--panel);
      border: 1px solid var(--border);
      transition: border-color var(--transition-fast);
    }
    .blog-related-card:hover { border-color: rgba(233, 30, 99, 0.32); }
    .blog-related-card .rel-kicker {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #FF6FA5;
      font-weight: var(--weight-bold);
    }
    .blog-related-card h3 {
      font-family: var(--font-display);
      font-size: 1.04rem;
      font-weight: var(--weight-bold);
      color: var(--text-primary);
      margin: 0.3rem 0 0;
      line-height: 1.3;
    }

    .blog-back {
      margin-top: 2.4rem;
      font-size: 0.92rem;
    }
    .blog-back a { color: var(--text-secondary); }
    .blog-back a:hover { color: var(--text-primary); }
  </style>
</head>
<body class="lp-body" data-no-shell>

  <header class="lp-nav" id="lpNav">
    <div class="lp-nav-inner">
      <a class="lp-nav-logo" href="/" aria-label="Somto — home">
        <img src="/icons/somto-wordmark.png" alt="Somto">
      </a>
      <div class="lp-nav-actions">
        <a class="lp-nav-link" href="/blog/">Blog</a>
        <a class="lp-nav-cta" href="/login.html?next=/home.html">Entra</a>
      </div>
    </div>
  </header>

  <main>
    <article class="blog-article">
      <div class="blog-wrap">
        <nav class="blog-crumbs" aria-label="Percorso">
          <a href="/">Home</a><span aria-hidden="true">›</span><a href="/blog/">Blog</a><span aria-hidden="true">›</span>{{ title }}
        </nav>

        <span class="lp-eyebrow">{{ kicker or "Guida Somto" }}</span>
        <h1>{{ title }}</h1>

        <div class="blog-meta">
          <time datetime="{{ date | isoDate }}">{{ date | dateIt }}</time>
          <span aria-hidden="true">·</span>
          <span>{{ readingTime or "Lettura ~6 min" }}</span>
          <span aria-hidden="true">·</span>
          <span>Redazione Somto</span>
        </div>

        {% if lede %}<p class="blog-lede">{{ lede }}</p>{% endif %}

        <div class="blog-body">
          {{ content | safe }}
        </div>

        <div class="blog-cta">
          <h2>{{ ctaTitle or "Tieni in ordine cosa guardare" }}</h2>
          <p>{{ ctaText or "Somto è il social gratuito per chi ama film e serie TV: watchlist, voti, quiz e consigli tra amici, su web e iOS." }}</p>
          <a class="lp-btn lp-btn-primary" href="/login.html?next=/home.html">Entra su Somto</a>
        </div>

        {%- set relSlugs = relatedSlugs or [] -%}
        {%- set relatedPosts = [] -%}
        {%- for post in collections.articoli -%}
          {%- if post.data.slug in relSlugs -%}
            {%- set relatedPosts = (relatedPosts.push(post), relatedPosts) -%}
          {%- endif -%}
        {%- endfor -%}
        {% if relatedPosts.length %}
        <section class="blog-related">
          <h2>Continua a leggere</h2>
          <div class="blog-related-grid">
            {% for post in relatedPosts %}
            <a class="blog-related-card" href="/blog/{{ post.data.slug }}/">
              <span class="rel-kicker">Blog</span>
              <h3>{{ post.data.title }}</h3>
            </a>
            {% endfor %}
          </div>
        </section>
        {% endif %}

        <p class="blog-back"><a href="/blog/">← Torna a tutti gli articoli</a></p>
      </div>
    </article>
  </main>

  <footer class="lp-footer">
    <div class="lp-footer-inner">
      <div class="lp-footer-brand">
        <img src="/icons/somto-wordmark.png" alt="Somto">
        <p>Il social per chi ama film e serie TV. Vota, scopri e decidi cosa guardare con gli amici.</p>
      </div>
      <nav class="lp-footer-cols" aria-label="Link del sito">
        <div class="lp-footer-col">
          <h4>Somto</h4>
          <a href="/">Home</a>
          <a href="/blog/">Blog</a>
          <a href="/login.html?next=/home.html">Accedi</a>
        </div>
        <div class="lp-footer-col">
          <h4>Scopri</h4>
          <a href="/watchlist-film-serie.html">Watchlist</a>
          <a href="/app-recensioni-film-serie.html">Voti e recensioni</a>
          <a href="/quiz-film-serie-tv.html">Quiz</a>
          <a href="/consigli-film-serie-amici.html">Consigli tra amici</a>
        </div>
        <div class="lp-footer-col">
          <h4>Legale</h4>
          <a href="/privacy.html">Privacy</a>
          <a href="/terms.html">Termini</a>
          <a href="/cookies.html">Cookie</a>
        </div>
        <div class="lp-footer-col">
          <h4>Supporto</h4>
          <a href="/support.html">Centro assistenza</a>
        </div>
      </nav>
    </div>
    <div class="lp-footer-base">© 2026 Somto. Tutti i diritti riservati.</div>
  </footer>

  <script>
    (function () {
      var nav = document.getElementById("lpNav");
      if (!nav) return;
      var onScroll = function () { nav.classList.toggle("is-scrolled", window.scrollY > 12); };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    })();
  </script>
</body>
</html>
