---
permalink: index.html
title: "Blog di Somto — film, serie TV e watchlist"
description: "Guide, classifiche e consigli su film e serie TV: cosa guardare, serie simili ai tuoi titoli preferiti e come organizzare la watchlist. Il blog di Somto."
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.blogBaseUrl }}/">
  <link rel="alternate" hreflang="it-IT" href="{{ site.blogBaseUrl }}/">
  <link rel="alternate" hreflang="x-default" href="{{ site.blogBaseUrl }}/">
  <meta name="robots" content="index,follow">
  <meta name="theme-color" content="#0A0A0A">
  <meta name="author" content="Somto">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Somto">
  <meta property="og:locale" content="it_IT">
  <meta property="og:url" content="{{ site.blogBaseUrl }}/">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="{{ site.baseUrl }}/icons/icon-512.png">
  <meta property="og:image:alt" content="Somto">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ site.baseUrl }}/icons/icon-512.png">

  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-180.png">

  <link rel="stylesheet" href="/css/landing.bundle.css">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "Blog di Somto",
    "description": {{ description | dump | safe }},
    "url": "{{ site.blogBaseUrl }}/",
    "inLanguage": "it-IT",
    "publisher": {
      "@type": "Organization",
      "name": "Somto",
      "url": "{{ site.baseUrl }}/",
      "logo": {
        "@type": "ImageObject",
        "url": "{{ site.baseUrl }}/icons/icon-512.png"
      }
    },
    "blogPost": [
      {%- for post in collections.articoli -%}
      {
        "@type": "BlogPosting",
        "headline": {{ post.data.title | dump | safe }},
        "description": {{ post.data.description | dump | safe }},
        "datePublished": "{{ post.date | isoDate }}",
        "url": "{{ site.blogBaseUrl }}/{{ post.data.slug }}/"
      }{% if not loop.last %},{% endif %}
      {%- endfor -%}
    ]
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.baseUrl }}/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "{{ site.blogBaseUrl }}/" }
    ]
  }
  </script>

  <style>
    .blog-hub-hero {
      position: relative;
      padding: calc(var(--safe-top) + 8rem) 1.25rem 2.5rem;
      text-align: center;
      overflow: hidden;
    }
    .blog-hub-hero .lp-hero-inner {
      position: relative;
      z-index: 1;
      width: min(100%, 760px);
      margin: 0 auto;
    }
    .blog-hub-hero h1 {
      font-family: var(--font-display);
      font-size: clamp(2.1rem, 5.6vw, 3.5rem);
      font-weight: var(--weight-black);
      letter-spacing: -0.035em;
      line-height: 1.06;
      max-width: 760px;
      margin: 1rem auto 0;
    }
    .blog-hub-hero p {
      font-size: clamp(1rem, 2.4vw, 1.2rem);
      line-height: 1.55;
      color: var(--text-secondary);
      max-width: 560px;
      margin: 1.1rem auto 0;
    }

    .blog-list {
      max-width: 760px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .blog-card {
      display: block;
      padding: 1.5rem 1.6rem;
      border-radius: var(--radius-card);
      background: var(--glass-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-card);
      transition: border-color var(--transition-fast), transform var(--transition-fast);
    }
    .blog-card:hover {
      border-color: rgba(233, 30, 99, 0.34);
      transform: translateY(-2px);
    }
    .blog-card-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.8rem;
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 0.6rem;
    }
    .blog-card-kicker {
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: var(--weight-bold);
      color: #FF6FA5;
    }
    .blog-card h2 {
      font-family: var(--font-display);
      font-size: clamp(1.2rem, 3vw, 1.5rem);
      font-weight: var(--weight-bold);
      letter-spacing: -0.02em;
      line-height: 1.22;
      color: var(--text-primary);
      margin: 0 0 0.45rem;
    }
    .blog-card p {
      margin: 0;
      color: var(--text-secondary);
      font-size: 0.97rem;
      line-height: 1.6;
    }
    .blog-card-more {
      display: inline-block;
      margin-top: 0.85rem;
      font-size: 0.9rem;
      font-weight: var(--weight-bold);
      color: #FF6FA5;
    }
  </style>
</head>
<body class="lp-body" data-no-shell>

  <header class="lp-nav" id="lpNav">
    <div class="lp-nav-inner">
      <a class="lp-nav-logo" href="/" aria-label="Somto — home">
        <img src="/icons/somto-wordmark.png" alt="Somto">
      </a>
      <div class="lp-nav-actions">
        <a class="lp-nav-link" href="/blog/" aria-current="page">Blog</a>
        <a class="lp-nav-cta" href="/login.html?next=/home.html">Entra</a>
      </div>
    </div>
  </header>

  <main>
    <section class="blog-hub-hero">
      <div class="lp-hero-glow g1"></div>
      <div class="lp-hero-glow g2"></div>
      <div class="lp-hero-glow g3"></div>
      <div class="lp-hero-inner">
        <span class="lp-eyebrow">Blog · Somto</span>
        <h1>Cosa guardare, <span class="lp-grad-text">spiegato bene</span></h1>
        <p>Guide, classifiche e consigli su film e serie TV. Per scegliere meglio cosa vedere e tenere in ordine la tua watchlist.</p>
      </div>
    </section>

    <section class="lp-section" style="padding-top: 1rem;">
      <div class="lp-container">
        <div class="blog-list">
          {%- for post in collections.articoli -%}
          <a class="blog-card" href="/blog/{{ post.data.slug }}/">
            <div class="blog-card-meta">
              <span class="blog-card-kicker">{{ post.data.kicker or "Guida" }}</span>
              <span aria-hidden="true">·</span>
              <time datetime="{{ post.date | isoDate }}">{{ post.date | dateIt }}</time>
              <span aria-hidden="true">·</span>
              <span>{{ post.data.readingTime or "Lettura ~6 min" }}</span>
            </div>
            <h2>{{ post.data.title }}</h2>
            <p>{{ post.data.description }}</p>
            <span class="blog-card-more">Leggi l'articolo →</span>
          </a>
          {%- endfor -%}
        </div>
      </div>
    </section>

    <section class="lp-section lp-final">
      <div class="lp-container">
        <div class="lp-final-inner">
          <h2>Metti in pratica i consigli</h2>
          <p>Salva i titoli che ti ispirano nella watchlist di Somto, votali e scopri cosa guardano gli amici. Gratis, su web e iOS.</p>
          <a class="lp-btn lp-btn-primary" href="/login.html?next=/home.html">Entra su Somto</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="lp-footer">
    <div class="lp-footer-inner">
      <div class="lp-footer-brand">
        <img src="/icons/somto-wordmark.png" alt="Somto">
        <p>Il social per chi ama film e serie TV. Vota, scopri e decidi cosa guardare con gli amici.</p>
      </div>
      <nav class="lp-footer-cols" aria-label="Link del sito">
        <div class="lp-footer-col">
          <h4>Somto</h4>
          <a href="/">Home</a>
          <a href="/blog/">Blog</a>
          <a href="/login.html?next=/home.html">Accedi</a>
        </div>
        <div class="lp-footer-col">
          <h4>Scopri</h4>
          <a href="/watchlist-film-serie.html">Watchlist</a>
          <a href="/app-recensioni-film-serie.html">Voti e recensioni</a>
          <a href="/quiz-film-serie-tv.html">Quiz</a>
          <a href="/consigli-film-serie-amici.html">Consigli tra amici</a>
        </div>
        <div class="lp-footer-col">
          <h4>Legale</h4>
          <a href="/privacy.html">Privacy</a>
          <a href="/terms.html">Termini</a>
          <a href="/cookies.html">Cookie</a>
        </div>
        <div class="lp-footer-col">
          <h4>Supporto</h4>
          <a href="/support.html">Centro assistenza</a>
        </div>
      </nav>
    </div>
    <div class="lp-footer-base">© 2026 Somto. Tutti i diritti riservati.</div>
  </footer>

  <script>
    (function () {
      var nav = document.getElementById("lpNav");
      if (!nav) return;
      var onScroll = function () { nav.classList.toggle("is-scrolled", window.scrollY > 12); };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    })();
  </script>
</body>
</html>
