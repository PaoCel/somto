# Copy only the keys you need into `.env.<firebase-project-id>`.
# Never commit real values. Firebase loads project-specific files on deploy.

ADMIN_UIDS=uid_admin_1,uid_admin_2
ANALYTICS_EXCLUDED_UIDS=uid_test_1,uid_test_2
SUPPORT_UID=uid_support
PERSONAL_ANALYTICS_ALLOWED_EMAIL=admin@example.com
ADMIN_NOTIFICATION_EMAIL=admin@example.com
OPERATOR_EMAIL=operator@example.com

TMDB_KEY=tmdb_api_key_here
TRAKT_CLIENT_ID=trakt_client_id_here
TRAKT_CLIENT_SECRET=trakt_client_secret_here
OPENAI_API_KEY=openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
BREVO_API_KEY=brevo_api_key_here
GIPHY_API_KEY=giphy_api_key_here

TMDB_IMPORT_LIMIT_PER_RUN=150
TMDB_IMPORT_RECENT_PAGE_WINDOW=40
TMDB_IMPORT_PAGES_PER_TYPE=12
TMDB_IMPORT_MIN_REQ_GAP_MS=130
TMDB_IMPORT_MAX_API_CALLS=150
