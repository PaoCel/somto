          }
        }
      }
    },
    "Questo è un profilo guidato da Somto e non riceve messaggi personali.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a Guided profile run by Somto and doesn't receive personal messages."
          }
        }
      }
    },
    "Qui compariranno i post della tua rete con immagine, commenti e condivisioni.": {
      "localizations": {
