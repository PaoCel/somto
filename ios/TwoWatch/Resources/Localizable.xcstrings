    "Quando chiudi l'import, le voci ancora da decidere vengono saltate e non aggiunte alla libreria.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you close the import, entries you haven't decided on yet are skipped and not added to your library."
          }
